GONKA_API_KEY=                                          # sk-… from the GonkaRouter dashboard
GONKA_BASE_URL_OPENAI=https://api.gonkarouter.io/v1

DATABASE_URL=                                           # Neon Postgres, pooled, sslmode=require

BETTER_AUTH_SECRET=                                     # 32+ random bytes
BETTER_AUTH_URL=                                        # Public origin, no trailing slash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GUEST_EMAIL=
GUEST_PASSWORD=

MASCOT_ENABLED=false
WORKER_CONCURRENCY=                                     # 1–4, default 1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

TAVILY_API_KEY=

CHAT_PROVIDER=                                          # gemini | gonka, default gonka
CHAT_MODEL=
