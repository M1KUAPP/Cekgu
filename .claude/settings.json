{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh\" ] || bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh\"",
            "timeout": 5,
            "statusMessage": "Checking git command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
